# FastAPI backend origin for all mobile APIs.
# Android emulator -> http://10.0.2.2:8000
# iOS simulator    -> http://127.0.0.1:8000
# Physical device  -> http://<YOUR_MACHINE_LAN_IP>:8000  (e.g. http://192.168.1.10:8000)
# Production       -> your deployed backend origin, e.g. https://formbae-v1-backend.onrender.com
BACKEND_API_BASE_URL=http://10.0.2.2:8000

# Public site for web payment fallback / deep links
SITE_URL=https://formbae.in
