# Next.js origin. Kept for payment/web compatibility and fallback routes.
# Android emulator -> http://10.0.2.2:3000
# iOS simulator    -> http://127.0.0.1:3000
# Physical device  -> http://<YOUR_MACHINE_LAN_IP>:3000  (e.g. http://192.168.1.10:3000)
API_BASE_URL=http://10.0.2.2:3000

# FastAPI backend origin for direct app data APIs. This removes the app -> frontend -> backend hop
# for auth, profile, workouts, progress, diet diary, messages, trainer options, and activity.
# Android emulator -> http://10.0.2.2:8000
# iOS simulator    -> http://127.0.0.1:8000
# Production       -> your deployed backend origin, e.g. https://formbae-backend.onrender.com
BACKEND_API_BASE_URL=http://10.0.2.2:8000

# Public site for web payment fallback / deep links
SITE_URL=https://formbae.in

# Razorpay public key (test or live). Used by the native checkout SDK.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
