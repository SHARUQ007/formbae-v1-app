<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Phone sign-in verifies the device with a silent push, and without this every
	     attempt logs "no valid aps-environment entitlement string found" and falls back to
	     a reCAPTCHA sheet. Added through Xcode's Push Notifications capability, which also
	     enables it on the App ID - claiming it here alone fails the build, because a
	     provisioning profile that does not carry it is rejected outright. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:formbae.in</string>
	</array>
</dict>
</plist>
